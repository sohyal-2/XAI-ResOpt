POSTGRES_DB=xai_resopt
POSTGRES_USER=xai_resopt
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
DATABASE_URL=postgresql://xai_resopt:change-me-for-local-development@localhost:5432/xai_resopt
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=development-only-change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
MAX_UPLOAD_SIZE_BYTES=10485760
URL_FETCH_TIMEOUT_SECONDS=10
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==============================================================================
# AI Provider Abstraction & Model Configuration
# Providers: auto, mock, openai, anthropic, gemini, ollama
# In 'auto' mode or if keys are missing, the system uses 'mock' development mode.
# ==============================================================================
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=30

# OpenAI (or compatible gateways e.g. Groq, vLLM, DeepSeek)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local / Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# External Evidence & Integrations
GITHUB_TOKEN=

# Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
